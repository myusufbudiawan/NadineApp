{
  "expo": {
    "name": "PreemieTrack",
    "slug": "preemietrack",
    "scheme": "preemietrack",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "backgroundColor": "#f8f7f6",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-sqlite",
      "expo-local-authentication",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "backgroundColor": "#f8f7f6"
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.preemietrack",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use biometric to unlock PreemieTrack."
      }
    },
    "android": {
      "package": "com.anonymous.preemietrack",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#faf8f6"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ce7c8dd-cfb5-472e-a49c-bc57dab9547a"
      }
    },
    "owner": "myusufb"
  }
}
