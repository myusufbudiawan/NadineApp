{
  "expo": {
    "name": "PreemieTrack",
    "slug": "preemietrack",
    "scheme": "preemietrack",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "backgroundColor": "#f8f7f6",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-sqlite",
      "expo-local-authentication",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "backgroundColor": "#f8f7f6"
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-sharing",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/CormorantGaramond_600SemiBold.ttf",
            "./assets/fonts/Lora_400Regular.ttf",
            "./assets/fonts/Lora_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "BabyStatusSquareWidget",
              "label": "Baby status (square)",
              "description": "A quick snapshot of age, weight and today's feeds.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "300dp",
              "maxResizeHeight": "300dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "BabyStatusBannerWidget",
              "label": "Baby status (banner)",
              "description": "A wide snapshot bar with quick-add for weight and feeding.",
              "minWidth": "250dp",
              "minHeight": "100dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "400dp",
              "maxResizeHeight": "150dp",
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.preemietrack",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use biometric to unlock PreemieTrack."
      }
    },
    "android": {
      "package": "com.anonymous.preemietrack",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#faf8f6"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ce7c8dd-cfb5-472e-a49c-bc57dab9547a"
      }
    },
    "owner": "myusufb"
  }
}
