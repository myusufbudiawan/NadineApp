{
  "expo": {
    "name": "PreemieTrack",
    "slug": "preemietrack",
    "scheme": "preemietrack",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-sqlite",
      "expo-local-authentication",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.preemietrack",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock PreemieTrack."
      }
    }
  }
}
