{
  "expo": {
    "name": "PreemieTrack",
    "slug": "preemietrack",
    "scheme": "preemietrack",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-sqlite",
      "expo-local-authentication",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.preemietrack",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock PreemieTrack."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ce7c8dd-cfb5-472e-a49c-bc57dab9547a"
      }
    },
    "owner": "myusufb"
  }
}
