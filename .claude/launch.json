{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web", "--prefix", "apps/mobile", "--", "--port", "8090"],
      "port": 8090
    },
    {
      "name": "mobile-web-offline",
      "runtimeExecutable": "env",
      "runtimeArgs": ["EXPO_PUBLIC_OFFLINE_ONLY=1", "npm", "run", "web", "--prefix", "apps/mobile", "--", "--port", "8091"],
      "port": 8091
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "services/api"],
      "port": 3000
    }
  ]
}
