{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web", "--prefix", "apps/mobile", "--", "--port", "8090"],
      "port": 8090
    },
    {
      "name": "mobile-metro",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--prefix", "apps/mobile", "--", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "services/api"],
      "port": 3000
    }
  ]
}
